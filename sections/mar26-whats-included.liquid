{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
MAR26 WHAT'S INCLUDED
VERSION: 3.2.0 - Centered Title & Halved Gaps Optimization
- Centered Product Name: text-align center on vertical card title
- Halved Spacing: Reduced top & bottom spacing around product title by 50%
- Balanced Ratio: Compact, streamlined card height with 110px desktop media box, 12px border radius
- Typography & Layout: 0.875rem 2-line clamped title, inline compact stepper and price
- Interactive: Quantity stepper, pricing, and Add to Bundle CTA syncing with buy flow
----------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<script>
  console.log("MAR26 What's Included - Version: 3.2.0");
</script>

<style>
  #shopify-section-{{ section.id }} {
    padding: 30px 0 !important;
    background-color: #f8fafc;
    margin: 0 !important;
  }
  #shopify-section-{{ section.id }} .mar26-included-sec {
    position: relative;
    background-color: transparent;
    padding: 0 1.25rem !important; /* Standardized Mobile Gutters (20px) */
    overflow: hidden;
  }
  @media (min-width: 640px) { #shopify-section-{{ section.id }} .mar26-included-sec { padding: 0 1.5rem !important; } }
  @media (min-width: 1024px) { #shopify-section-{{ section.id }} .mar26-included-sec { padding: 0 2rem !important; } }

  #shopify-section-{{ section.id }} .mar26-included-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.03;
    z-index: 1;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  #shopify-section-{{ section.id }} .mar26-included-inner {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Header */
  #shopify-section-{{ section.id }} .mar26-included-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  #shopify-section-{{ section.id }} .mar26-included-pretitle {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin: 0 0 1rem 0;
  }

  #shopify-section-{{ section.id }} .mar26-included-heading {
    font-size: 2.25rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.05em;
    line-height: 1;
    color: #0f172a;
    margin: 0 0 1.25rem 0;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .mar26-included-heading { font-size: 3rem; }
  }

  #shopify-section-{{ section.id }} .mar26-included-heading-gradient {
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  #shopify-section-{{ section.id }} .mar26-included-subheading {
    font-size: 1.05rem;
    font-weight: 500;
    color: #475569;
    margin: 0;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* Grid */
  #shopify-section-{{ section.id }} .mar26-included-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.5rem;
    justify-content: center;
  }
  @media (min-width: 640px) {
    #shopify-section-{{ section.id }} .mar26-included-grid { 
      grid-template-columns: repeat(2, minmax(0, 1fr)); 
    }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .mar26-included-grid { 
      grid-template-columns: repeat(4, minmax(0, 1fr)); 
    }
    #shopify-section-{{ section.id }} .mar26-included-grid--3 { 
      grid-template-columns: repeat(3, minmax(0, 1fr)); 
    }
    #shopify-section-{{ section.id }} .mar26-included-grid--4 { 
      grid-template-columns: repeat(4, minmax(0, 1fr)); 
    }
  }

  /* ── Modular Stepper Card: Vertical Mode Styling ─────────── */
  #shopify-section-{{ section.id }} .mar26-stepper-card--vertical {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    background: #ffffff;
    border: 1.5px solid #9ca3af;
    border-radius: 12px;
    padding: 0.75rem;
    box-sizing: border-box;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  #shopify-section-{{ section.id }} .mar26-stepper-card--vertical:hover {
    border-color: var(--mar26-red, #ff101f);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  /* Compact media container with clean ~4:3 aspect ratio (not overly vertical) */
  #shopify-section-{{ section.id }} .mar26-stepper-card__media-top {
    width: 100%;
    height: 110px;
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    margin-bottom: 0.25rem;
  }

  #shopify-section-{{ section.id }} .mar26-stepper-card__media-top img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .mar26-stepper-card__media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
  }

  /* Content: Title only, no description, balanced spacing */
  #shopify-section-{{ section.id }} .mar26-stepper-card__content {
    flex-grow: 1;
    margin-bottom: 0.25rem;
  }

  #shopify-section-{{ section.id }} .mar26-stepper-card__title {
    font-size: 0.875rem;
    font-weight: 700;
    font-family: var(--heading-font-family, "Montserrat", sans-serif);
    color: #0f172a;
    line-height: 1.25;
    margin: 0;
    text-align: center;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: 2.5em;
    max-height: 2.5em;
  }

  /* Bottom Row: Pricing, Stepper, and CTA Button */
  #shopify-section-{{ section.id }} .mar26-stepper-card__row-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.25rem;
    border-top: 1px solid #f3f4f6;
    gap: 0.5rem;
    margin-top: auto;
  }

  #shopify-section-{{ section.id }} .mar26-stepper-card__pricing {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .mar26-price-old {
    font-size: 0.75rem;
    color: #94a3b8;
    text-decoration: line-through;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .mar26-price-new {
    font-size: 1rem;
    font-weight: 900;
    color: var(--mar26-red, #ff101f);
  }

  #shopify-section-{{ section.id }} .mar26-stepper-card__controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: nowrap;
  }

  /* Add to Bundle CTA */
  #shopify-section-{{ section.id }} .mar26-card-cta-btn {
    padding: 0 0.75rem;
    height: 32px;
    border-radius: 8px;
    border: none;
    background: var(--mar26-red, #ff101f);
    color: #ffffff;
    font-weight: 800;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  #shopify-section-{{ section.id }} .mar26-card-cta-btn:hover {
    background: #dc2626;
  }

  #shopify-section-{{ section.id }} .mar26-card-cta-btn.is-added {
    background: #16a34a;
  }

  /* Mobile responsiveness: Keep card clean and match quantity selector size with buy flow */
  @media (max-width: 639px) {
    #shopify-section-{{ section.id }} .mar26-stepper-card--vertical {
      padding: 0.75rem;
      border-radius: 12px;
    }
    #shopify-section-{{ section.id }} .mar26-stepper-card__media-top {
      height: 120px;
    }
    #shopify-section-{{ section.id }} .mar26-stepper-card__title {
      font-size: 0.95rem;
      min-height: auto;
      max-height: none;
    }
    #shopify-section-{{ section.id }} .mar26-price-new {
      font-size: 1.125rem !important;
    }
    #shopify-section-{{ section.id }} .mar26-price-old {
      font-size: 0.875rem !important;
    }
  }
</style>

{%- liquid
  assign meta_items = product.metafields.custom.mar26_included_items.value | default: product.metafields.custom.included_products.value
  assign has_meta_items = false
  if meta_items != blank and meta_items.count > 0
    assign has_meta_items = true
  endif

  assign pre_title = product.metafields.custom.mar_26_included_pre_title.value | default: section.settings.pre_title
  assign heading_main = product.metafields.custom.mar_26_included_heading.value | default: section.settings.black_title
  assign subheading = product.metafields.custom.mar_26_included_subheading.value | default: section.settings.subheading

  assign show_section = false
  if has_meta_items or section.blocks.size > 0
    assign show_section = true
  endif
-%}

{%- if show_section -%}
<section class="mar26-included-sec">
  <div class="mar26-included-grain"></div>

  <div class="mar26-included-inner">
    <header class="mar26-included-header">
      {%- if pre_title != blank -%}
        <p class="mar26-included-pretitle" style="color: {{ section.settings.pre_title_color }};">{{ pre_title | escape }}</p>
      {%- endif -%}

      {%- if heading_main != blank or section.settings.gradient_title != blank -%}
        <h2 class="mar26-included-heading">
          {%- if heading_main != blank -%}
            {{ heading_main | escape }}
          {%- endif -%}
          {%- if section.settings.gradient_title != blank -%}
            {{ ' ' }}<span class="mar26-included-heading-gradient" style="background-image: linear-gradient(to right, {{ section.settings.gradient_left_color }}, {{ section.settings.gradient_right_color }}); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; color: transparent;">{{ section.settings.gradient_title | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if subheading != blank -%}
        <p class="mar26-included-subheading">{{ subheading | escape }}</p>
      {%- endif -%}
    </header>

    <div class="mar26-included-grid mar26-included-grid--{{ section.settings.columns }}">
      {%- comment -%} 1. Metafield Products {%- endcomment -%}
      {%- if has_meta_items -%}
        {%- for item in meta_items -%}
          {%- liquid
            assign card_product = nil
            if item.featured_image != blank or item.title != blank and item.image == blank
              assign card_product = item
            endif

            if card_product != blank
              assign c_title = card_product.title
              assign c_image = card_product.featured_image
            else
              assign c_title = item.title
              assign c_image = item.image
            endif
          -%}
          {%- render 'mar26-product-card-stepper',
            card_product: card_product,
            card_title: c_title,
            card_image: c_image,
            layout: 'vertical',
            show_desc: false,
            show_cta: false,
            modifier: 'mar26-included-card-stepper'
          -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} 2. Manual Blocks {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_product = block.settings.product
          if card_product != blank
            assign c_title = block.settings.title | default: card_product.title
            assign c_image = block.settings.image | default: card_product.featured_image
          else
            assign c_title = block.settings.title
            assign c_image = block.settings.image
          endif
        -%}
        {%- render 'mar26-product-card-stepper',
          card_product: card_product,
          card_title: c_title,
          card_image: c_image,
          layout: 'vertical',
          show_desc: false,
          show_cta: false,
          modifier: 'mar26-included-card-stepper',
          shopify_attributes: block.shopify_attributes
        -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<script>
  function mar26UpdateStepperQty(btn, delta) {
    const card = btn.closest('.mar26-stepper-card');
    if (!card) return;

    const valEl = card.querySelector('.mar26-qty-val');
    const minQty = parseInt(card.dataset.minQty || '0', 10);
    let val = parseInt(valEl.innerText, 10) || 0;
    val = Math.max(minQty, val + delta);
    valEl.innerText = val;

    const ctaBtn = card.querySelector('.mar26-card-cta-btn');
    if (ctaBtn) {
      if (val > 0) {
        ctaBtn.innerText = `Added (${val})`;
        ctaBtn.classList.add('is-added');
      } else {
        ctaBtn.innerText = 'Add to Bundle';
        ctaBtn.classList.remove('is-added');
      }
    }

    if (val > 0) {
      card.classList.add('is-selected');
    } else if (card.dataset.isBundle !== 'true') {
      card.classList.remove('is-selected');
    }

    // Sync to other stepper cards on page with identical variant ID
    const variantId = card.dataset.variantId;
    if (variantId) {
      document.querySelectorAll(`.mar26-stepper-card[data-variant-id="${variantId}"]`).forEach(otherCard => {
        if (otherCard !== card) {
          const otherQty = otherCard.querySelector('.mar26-qty-val');
          if (otherQty) otherQty.innerText = val;
          const otherCta = otherCard.querySelector('.mar26-card-cta-btn');
          if (otherCta) {
            if (val > 0) {
              otherCta.innerText = `Added (${val})`;
              otherCta.classList.add('is-added');
            } else {
              otherCta.innerText = 'Add to Bundle';
              otherCta.classList.remove('is-added');
            }
          }
          if (val > 0) otherCard.classList.add('is-selected');
          else if (otherCard.dataset.isBundle !== 'true') otherCard.classList.remove('is-selected');
        }
      });
    }

    if (typeof mar26UpdateCalculations === 'function') {
      mar26UpdateCalculations();
    }
  }

  async function mar26CardCtaClick(btn) {
    const card = btn.closest('.mar26-stepper-card');
    if (!card) return;

    const valEl = card.querySelector('.mar26-qty-val');
    let val = parseInt(valEl.innerText, 10) || 0;
    if (val === 0) {
      val = 1;
      valEl.innerText = val;
      btn.innerText = `Added (${val})`;
      btn.classList.add('is-added');
      card.classList.add('is-selected');

      const variantId = card.dataset.variantId;
      if (variantId) {
        document.querySelectorAll(`.mar26-stepper-card[data-variant-id="${variantId}"]`).forEach(otherCard => {
          if (otherCard !== card) {
            const otherQty = otherCard.querySelector('.mar26-qty-val');
            if (otherQty) otherQty.innerText = val;
            const otherCta = otherCard.querySelector('.mar26-card-cta-btn');
            if (otherCta) {
              otherCta.innerText = `Added (${val})`;
              otherCta.classList.add('is-added');
            }
            otherCard.classList.add('is-selected');
          }
        });
      }

      if (typeof mar26UpdateCalculations === 'function') {
        mar26UpdateCalculations();
        return;
      }
    }

    // If no buy-flow widget on page, add to cart directly
    if (typeof mar26UpdateCalculations !== 'function') {
      const variantId = btn.dataset.variantId;
      if (!variantId) return;

      const originalText = btn.innerText;
      btn.disabled = true;
      btn.innerText = '...';

      try {
        const res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: [{ id: variantId, quantity: val }]
          })
        });
        if (res.ok) {
          btn.classList.add('is-added');
          btn.innerText = `Added (${val})`;
          btn.disabled = false;
        } else {
          const err = await res.json();
          alert('Could not add item: ' + (err.description || err.message));
          btn.disabled = false;
          btn.innerText = originalText;
        }
      } catch (e) {
        console.error(e);
        btn.disabled = false;
        btn.innerText = originalText;
      }
    }
  }

  // Backwards compatibility
  function mar26IncChangeQty(btn, delta) {
    mar26UpdateStepperQty(btn, delta);
  }
  function mar26IncAddToCart(btn) {
    mar26CardCtaClick(btn);
  }
</script>

