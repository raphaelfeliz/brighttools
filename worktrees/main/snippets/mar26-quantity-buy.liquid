{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
file-summary: MAR26 Quantity + Buy. Renders quantity selector and buy buttons with flex: 0 0 auto layout and pure buy button style inheritance.
version-name: Size LG Synchronization & Pure Style Inheritance
version-number: 1.2.4
version-date: 2026-07-26
version-summary: Passes button_size lg to buy-buttons render and syncs quantity stepper height to 42px for identical sizing to isolated buy buttons.
----------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}
{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
MAR26 QUANTITY-BUY
----------------------------------------------------------------------------------------------------------------------

Renders the native quantity selector and buy buttons inside the product info column.
Accepts:
* product
* product_form_id
* block
{%- endcomment -%}

{%- assign variant = product.selected_or_first_available_variant -%}

{%- if variant != nil -%}
  <style>
    #shopify-section-{{ section.id }} .mar26-quantity-price {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end !important;
      gap: 0.75rem;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .mar26-quantity-price__quantity {
      flex: 0 0 auto !important;
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    #shopify-section-{{ section.id }} .mar26-quantity-price__quantity .block-label {
      font-size: 12px;
      line-height: 1.3;
      margin-bottom: 0.35rem;
      font-weight: 500;
    }

    /* Quantity Selector Height & Pill Synchronization to Match Standalone LG Buttons */
    #shopify-section-{{ section.id }} .mar26-quantity-price__quantity .quantity-selector {
      min-height: 42px !important;
      height: 42px !important;
      border-radius: 9999px !important;
      border: 1px solid #cbd5e1 !important;
      background-color: #ffffff !important;
      padding: 0 0.5rem !important;
      box-shadow: none !important;
      box-sizing: border-box !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    #shopify-section-{{ section.id }} .mar26-quantity-price__quantity .quantity-selector__button {
      inline-size: 1.85rem !important;
      block-size: 1.85rem !important;
      border-radius: 50% !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      color: #0f172a !important;
    }
    #shopify-section-{{ section.id }} .mar26-quantity-price__quantity .quantity-selector__button svg {
      color: #0f172a !important;
      stroke: #0f172a !important;
    }

    #shopify-section-{{ section.id }} .mar26-quantity-price__quantity .quantity-selector__input {
      min-block-size: 1.85rem !important;
      font-size: 0.9rem !important;
      font-weight: 600 !important;
      color: #0f172a !important;
    }

    /* Buy Buttons Container - Inherit exact layout from standalone buy_buttons block */
    #shopify-section-{{ section.id }} .mar26-quantity-price__buy {
      display: flex;
      flex: 0 0 auto !important;
      min-width: 0;
      align-self: flex-end !important;
      margin-top: auto !important;
    }

    #shopify-section-{{ section.id }} .mar26-quantity-price__buy .product-info__buy-buttons,
    #shopify-section-{{ section.id }} .mar26-quantity-price__buy buy-buttons {
      margin-bottom: 0 !important;
      width: auto !important;
      max-width: 440px !important;
      align-self: flex-end !important;
      align-items: flex-end !important;
    }

    #shopify-section-{{ section.id }} .mar26-quantity-price__quantity .text-sm {
      font-size: 12px;
      line-height: 1.35;
      margin-top: 0.4rem;
    }

    @media screen and (max-width: 999px) {
      #shopify-section-{{ section.id }} .mar26-quantity-price {
        align-items: stretch;
      }

      #shopify-section-{{ section.id }} .mar26-quantity-price__quantity {
        display: none !important;
      }

      #shopify-section-{{ section.id }} .mar26-quantity-price__buy {
        flex-basis: 100%;
      }
    }
  </style>

  <div class="mar26-quantity-price">
    {%- if product.available -%}
      <div class="mar26-quantity-price__quantity form-control">
        <label for="{{ product_form_id }}-quantity" class="block-label text-subdued">{{- 'product.quantity.label' | t -}}:</label>

        <quantity-selector class="quantity-selector">
          <button type="button" tabindex="-1" class="quantity-selector__button" aria-label="{{ 'product.quantity.decrease_quantity' | t }}">{% render 'icon' with 'minus', width: 10, height: 2 %}</button>
          <input id="{{ product_form_id }}-quantity" type="number" is="quantity-input" inputmode="numeric" class="quantity-selector__input" name="quantity" form="{{ product_form_id }}" value="{{ variant.quantity_rule.min | default: 1 }}" step="{{ variant.quantity_rule.increment }}" min="{{ variant.quantity_rule.min }}" {% if variant.quantity_rule.max != nil %}max="{{ variant.quantity_rule.max }}"{% endif %} autocomplete="off">
          <button type="button" tabindex="-1" class="quantity-selector__button" aria-label="{{ 'product.quantity.increase_quantity' | t }}">{% render 'icon' with 'plus', width: 10, height: 10 %}</button>
        </quantity-selector>

        {%- liquid
          assign quantity_rules = ''

          if variant.quantity_rule.min > 1
            assign rule = 'product.quantity.minimum_of' | t: min: variant.quantity_rule.min
            assign quantity_rules = quantity_rules | append: ' / ' | append: rule
          endif

          if variant.quantity_rule.max != nil
            assign rule = 'product.quantity.maximum_of' | t: max: variant.quantity_rule.max
            assign quantity_rules = quantity_rules | append: ' / ' | append: rule
          endif

          if variant.quantity_rule.increment > 1
            assign rule = 'product.quantity.increment_of' | t: step: variant.quantity_rule.increment
            assign quantity_rules = quantity_rules | append: ' / ' | append: rule
          endif
        -%}

        {%- if quantity_rules != blank -%}
          <p class="text-subdued text-sm">{{ quantity_rules | remove_first: ' / ' | capitalize }}</p>
        {%- endif -%}
      </div>

      {%- if request.page_type != 'password' -%}
        {%- assign show_dynamic_checkout = block.settings.show_payment_button | default: true -%}
        <div class="mar26-quantity-price__buy">
          <div class="product-info__buy-buttons">
            {%- render 'buy-buttons', product: product, form_id: product_form_id, button_size: 'lg', show_payment_button: show_dynamic_checkout, show_gift_card_recipient: block.settings.show_gift_card_recipient, atc_button_background: block.settings.atc_button_background, atc_button_text_color: block.settings.atc_button_text_color, payment_button_background: block.settings.payment_button_background, payment_button_text_color: block.settings.payment_button_text_color -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endif -%}
